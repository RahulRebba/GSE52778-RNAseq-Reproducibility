# Normalize text files in the repository
* text=auto

# Linux / cross-platform scripts and configuration
*.sh text eol=lf
*.R text eol=lf
*.py text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.nf text eol=lf
Dockerfile text eol=lf
*.md text eol=lf

# Windows PowerShell
*.ps1 text eol=crlf

# Binary files - never modify line endings
*.png binary
*.pbix binary
*.db binary
*.RData binary